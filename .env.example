# Copiar a .env y completar individualmente. No subir valores reales.
# URL y clave publica: proyecto Supabase > Connect / API Keys.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<clave-publica-publishable>
# Identificador para supabase link; no es una credencial.
SUPABASE_PROJECT_REF=<project-ref>
